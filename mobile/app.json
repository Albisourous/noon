{
  "expo": {
    "name": "OutSleep",
    "slug": "outsleep",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "outsleep",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.outsleep.app",
      "infoPlist": {
        "UIBackgroundModes": ["fetch", "processing"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "OutSleep reads your sleep data to compute your daily sleep score.",
          "NSHealthUpdateUsageDescription": "OutSleep does not write health data.",
          "background": false
        }
      ],
      "expo-notifications",
      "expo-secure-store"
    ]
  }
}
